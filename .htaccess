RewriteEngine On

# Redirect to public folder
RewriteBase /vps-vrt-back/website/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(?!public/)(.*)$ public/$1 [L]

