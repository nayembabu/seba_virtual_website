<script>
function autoFill() {
    document.querySelectorAll('input.form-control').forEach(function(inp) {
        if (inp.placeholder) inp.value = inp.placeholder;
    });
}
document.getElementById('dcrForm').addEventListener('submit', function(e) {
    if (!confirm("à¦¡à¦¿à¦¸à¦¿à¦†à¦° à¦œà§‡à¦¨à¦¾à¦°à§‡à¦Ÿ à¦•à¦°à¦¤à§‡ à¦«à¦¿ à¦•à¦¾à¦Ÿà¦¾ à¦¹à¦¬à§‡à¥¤ à¦†à¦ªà¦¨à¦¿ à¦•à¦¿ à¦¨à¦¿à¦¶à§à¦šà¦¿à¦¤?")) {
        e.preventDefault();
        return false;
    }
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').innerHTML = 'à¦ªà§à¦°à¦¸à§‡à¦¸à¦¿à¦‚ à¦¹à¦šà§à¦›à§‡...';
    return true;
});
</script>
