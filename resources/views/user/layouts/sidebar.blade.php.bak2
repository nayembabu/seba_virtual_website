        <style>
            /* ── AdminLTE Core Custom Variables ─────────────────── */
            :root {
                --lte-bg: #343a40;
                --lte-brand-border: #4b545c;
                --lte-text-muted: #c2c7d0;
                --lte-text-hover: #fff;
                --lte-accent: #3fbbc0; /* Customize to match your preference (#007bff for standard LTE blue) */
                --lte-item-hover: rgba(255, 255, 255, 0.1);
                --lte-item-active: rgba(255, 255, 255, 0.15);
                --lte-speed: 0.3s;
            }

            /* ── Sidebar Structural Changes ─────────────────────── */
            .main-sidebar {
                background-color: var(--lte-bg);
                width: 260px;
                min-height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                z-index: 1038;
                transition: width var(--lte-speed) ease-in-out;
                font-family: 'Source Sans Pro', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            }

            .brand-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 13px 16px;
                border-bottom: 1px solid var(--lte-brand-border);
                color: #fff !important;
                text-decoration: none !important;
                font-size: 1.25rem;
                line-height: 1.5;
            }

            .brand-image {
                font-size: 1.1rem;
                width: 2.1rem;
                text-align: center;
                color: var(--lte-accent);
            }

            .sidebar {
                padding: 12px 8px;
                height: calc(100vh - 57px);
                overflow-y: auto;
            }




            /* ── Nav List & Header ─────────────────────────────── */
            .nav-sidebar {
                list-style: none;
                padding: 0;
                margin: 0;
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .nav-header {
                font-size: 0.75rem;
                font-weight: 700;
                padding: 12px 8px 4px;
                color: #6c757d;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            /* ── Nav Link / Items ──────────────────────────────── */
            .nav-item {
                width: 100%;
                position: relative;
                list-style: none;
            }

            .nav-link {
                display: flex;
                align-items: center;
                padding: 8px 12px;
                color: var(--lte-text-muted) !important;
                text-decoration: none !important;
                border-radius: 4px;
                transition: background-color var(--lte-speed) ease, color var(--lte-speed) ease;
                font-size: 0.95rem;
                cursor: pointer;
            }

            .nav-link:hover {
                background-color: var(--lte-item-hover);
                color: var(--lte-text-hover) !important;
            }

            .nav-item.menu-open > .nav-link,
            .nav-link.active {
                background-color: var(--lte-item-active);
                color: #fff !important;
            }

            .nav-link.active {
                border-left: 3px solid var(--lte-accent);
                padding-left: 9px; /* Balance the border width */
            }

            /* Icons & Text */
            .nav-icon {
                width: 1.6rem;
                font-size: 1.1rem;
                text-align: center;
                margin-right: 6px;
                flex-shrink: 0;
            }

            .nav-link p {
                margin: 0;
                display: flex;
                align-items: center;
                width: 100%;
                justify-content: space-between;
                white-space: nowrap;
            }

            /* AdminLTE Styled Caret Right/Down */
            .nav-link .right {
                font-size: 0.8rem;
                transition: transform var(--lte-speed) ease;
                margin-left: auto;
            }

            .menu-open > .nav-link .right {
                transform: rotate(-90deg);
            }

            /* ── Multi-level Tree View Layout ─────────────────── */
            .nav-treeview {
                display: none;
                list-style: none;
                padding: 0;
                margin: 0;
                background-color: rgba(255, 255, 255, 0.02);
            }

            .menu-open > .nav-treeview {
                display: block;
            }

            /* Level 1 Indentation */
            .nav-treeview .nav-link {
                padding-left: 28px;
                font-size: 0.9rem;
            }

            /* Level 2 Indentation */
            .nav-treeview .nav-treeview .nav-link {
                padding-left: 44px;
                font-size: 0.85rem;
            }

            /* ── Badges ────────────────────────────────────────── */
            .badge-off {
                font-size: 0.65rem;
                padding: 2px 6px;
                font-weight: 700;
                text-transform: uppercase;
                border-radius: 0.25rem;
                background-color: #dc3545;
                color: #fff;
                margin-left: 6px;
            }

            /* ── Service Disabled State ────────────────────────── */
            .service-disabled {
                opacity: 0.4;
                pointer-events: none;
                cursor: not-allowed;
            }

            /* ── Mobile Layout Adjustments ─────────────────────── */
            @media (max-width: 991.98px) {
                .main-sidebar {
                    transform: translate3d(-250px, 0, 0);
                    transition: transform var(--lte-speed) ease-in-out;
                }

                body.sidebar-open .main-sidebar {
                    transform: translate3d(0, 0, 0);
                }
            }

            /* ... Keep all your previous sidebar styles ... */

            /* ── Enhanced Mobile Responsiveness ─────────────────── */
            @media (max-width: 991.98px) {
                .main-sidebar {
                    transform: translate3d(-250px, 0, 0);
                    transition: transform var(--lte-speed) ease-in-out;
                }

                /* When this class is attached to the body, the sidebar slides in */
                body.sidebar-open .main-sidebar {
                    transform: translate3d(0, 0, 0);
                }

                /* Mobile Backdrop Overlay */
                body.sidebar-open::after {
                    content: "";
                    position: fixed;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: rgba(0, 0, 0, 0.5);
                    z-index: 1037; /* Just under sidebar */
                }
            }
