}
.modern-sidebar .nav-sidebar > .nav-item.menu-open > .nav-link,
.modern-sidebar .nav-sidebar > .nav-item > .nav-link.active {
    background: linear-gradient(135deg, #0D47A1 0%, #1A237E 100%);
