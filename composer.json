{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Laravel 8 Application",
    "keywords": ["laravel", "framework"],
    "license": "MIT",

    "require": {
        "php": "^7.4|^8.0",
        "anhskohbo/no-captcha": "^3.4",
        "barryvdh/laravel-dompdf": "^2.0",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.2",
        "geoip2/geoip2": "^3.1",
        "hisorange/browser-detect": "^4.5",
        "intervention/image": "^3.11",
        "ixudra/curl": "^6.22",
        "jaggedsoft/php-binance-api": "^0.5",
        "jenssegers/agent": "^2.6",
        "laravel/breeze": "^1.10",
        "laravel/framework": "^8.83",
        "laravel/passport": "^10.4",
        "laravel/socialite": "^5.5",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^3.4",
        "mollie/laravel-mollie": "^2.19",
        "mpdf/mpdf": "^8.3",
        "nexmo/laravel": "^2.4",
        "phpmailer/phpmailer": "^6.6",
        "pragmarx/google2fa": "^8.0",
        "pusher/pusher-php-server": "^4.1",
        "securionpay/securionpay-php": "^2.5",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-image-optimizer": "^1.8",
        "stevebauman/location": "^7.5",
        "stevebauman/purify": "^4.0",
        "torann/geoip": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },

    "require-dev": {
        "fakerphp/faker": "^1.20",
        "mockery/mockery": "^1.5",
        "nunomaduro/collision": "^5.11",
        "phpunit/phpunit": "^9.5"
    },

    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helper/helper.php"
        ]
    },

    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },

    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },

    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "ignore-id": ["PKSA-8qx3-n5y5-vvnd", "PKSA-w7xr-vk7n-rstm", "PKSA-y2cr-5h3j-g3ys"],
                "block": false
            }
        },
        "audit": {
            "block-insecure": false
        }
    },

    "minimum-stability": "stable",
    "prefer-stable": true
}
